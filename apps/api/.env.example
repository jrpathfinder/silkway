NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://central_asia:local_dev_only@localhost:5432/central_asia
# Set to true for managed Postgres (Timeweb DBaaS, RDS, ...) — almost always
# required there, and unsupported by the plain local docker-compose Postgres.
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
DEFAULT_CITY_ID=moscow
OTP_TTL_SECONDS=300
# Secret used to hash OTP codes before storing them (OtpStore) — any random
# string is fine locally; use a real secret in production.
OTP_HASH_SECRET=change-me
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock
# Used to build absolute URLs the API hands back to clients — the ЮKassa
# return page and uploaded catalog-item photo URLs. Must be reachable from
# wherever those URLs get opened (the customer's browser/WebView), so set it
# to the real public origin in any non-local deployment.
PUBLIC_BASE_URL=http://localhost:3000
# Where AdminUploadsController writes catalog-item photos. Defaults to
# ./uploads next to the running process if unset — point this at a mounted,
# persisted volume in any deployment where the container filesystem doesn't
# survive restarts.
UPLOADS_DIR=
# mock logs the OTP code to the server console instead of sending it.
# sms.ru requires SMS_RU_API_ID (from sms.ru account settings).
SMS_PROVIDER=mock
SMS_RU_API_ID=
YANDEX_EDA_ENABLED=false
YANDEX_DELIVERY_ENABLED=false
# Admin panel (apps/admin) — required for /v1/admin/* routes; pick real values before deploying.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
