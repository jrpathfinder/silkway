NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://central_asia:local_dev_only@localhost:5432/central_asia
REDIS_URL=redis://localhost:6379
DEFAULT_CITY_ID=moscow
OTP_TTL_SECONDS=300
# Secret used to hash OTP codes before storing them (OtpStore) — any random
# string is fine locally; use a real secret in production.
OTP_HASH_SECRET=change-me
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock
# mock logs the OTP code to the server console instead of sending it.
# sms.ru requires SMS_RU_API_ID (from sms.ru account settings).
SMS_PROVIDER=mock
SMS_RU_API_ID=
YANDEX_EDA_ENABLED=false
YANDEX_DELIVERY_ENABLED=false
# Admin panel (apps/admin) — required for /v1/admin/* routes; pick real values before deploying.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
