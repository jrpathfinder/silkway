# Продакшн-конфиг для деплоя на Timeweb (Cloud-40 + управляемая PostgreSQL).
# Скопируйте в apps/api/.env.production и заполните реальными значениями —
# этот файл только шаблон, коммитить заполненную копию нельзя (секреты).
#
#   cp apps/api/.env.production.example apps/api/.env.production
#
# Используется через infra/docker-compose.prod.yml (env_file).

NODE_ENV=production
PORT=3000

# Строка подключения к Timeweb DBaaS PostgreSQL — взять в панели Timeweb,
# в разделе базы данных ("Параметры подключения" / "Connection string").
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Managed PostgreSQL почти всегда требует TLS — локальный docker Postgres
# его не поддерживает, поэтому в dev-окружении этот флаг был false.
DATABASE_SSL=true

# Redis не используется в проде, пока API работает в одном инстансе —
# оставить пустым, DatabaseService/RedisService откатятся на in-memory.
REDIS_URL=

DEFAULT_CITY_ID=moscow
OTP_TTL_SECONDS=300
# Сгенерировать: openssl rand -hex 32 — не использовать dev-заглушку.
OTP_HASH_SECRET=

PAYMENT_PROVIDER=yookassa
# БОЕВЫЕ ключи из личного кабинета ЮKassa (не тестовые test_... значения,
# которыми пользовались локально).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

DELIVERY_PROVIDER=mock

# Публичный адрес API — используется в ссылках на фото товаров и в
# возврате из ЮKassa. Должен совпадать с доменом из nginx-конфига.
PUBLIC_BASE_URL=https://silkway.nomiq.net

# Каталог для загруженных фото блюд — смонтирован как volume в
# docker-compose.prod.yml (uploads-data), поэтому переживает передеплой.
UPLOADS_DIR=/app/apps/api/uploads

SMS_PROVIDER=sms.ru
SMS_RU_API_ID=

YANDEX_EDA_ENABLED=false
YANDEX_DELIVERY_ENABLED=false

# Админ-панель (apps/admin) — обязательно сменить на реальные значения.
ADMIN_PASSWORD=
# Сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=
