# Конфиг nginx для продакшн-деплоя SilkWay на Timeweb.
#
# Установка:
#   1. cp infra/nginx/silkway.conf.template /etc/nginx/sites-available/silkway.conf
#   2. ln -s /etc/nginx/sites-available/silkway.conf /etc/nginx/sites-enabled/
#   3. nginx -t && systemctl reload nginx
#   4. certbot --nginx -d silkway.nomiq.net -d admin.nomiq.net
#      (certbot сам допишет сюда TLS-блоки и настроит редирект с 80 на 443 —
#      этот файл специально начинается только с http, без ssl_certificate)
#
# silkway.nomiq.net -> проксирует на API-контейнер (127.0.0.1:3000, см.
#                      docker-compose.prod.yml — контейнер слушает только
#                      loopback, наружу отдаёт только nginx)
# admin.nomiq.net  -> отдаёт статическую сборку апп/admin (npm run admin:build)

server {
    listen 80;
    server_name silkway.nomiq.net;

    # ЮKassa шлёт вебхуки на этот адрес — не режьте тело запроса и таймауты
    # слишком жёстко, платёжные уведомления должны доходить надёжно.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name admin.nomiq.net;

    root /var/www/silkway-admin;
    index index.html;

    # SPA — все не-файловые пути ведут на index.html, роутинг на клиенте.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
